# Local dev (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# For Vercel: use a hosted Postgres (Neon, Vercel Postgres, Supabase) and
# change provider in prisma/schema.prisma to "postgresql":
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# 32+ char secret. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-with-openssl-rand-base64-48"

# Public site URL (used for Stripe redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe — get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID for the 5€/mo Premium subscription
# Create a product in Stripe (5€ EUR recurring monthly) and paste its price ID
STRIPE_PRICE_ID="price_..."

# Anthropic — for the AI conversational coach on /ia
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Optional: WhatsApp number for Orange Money / Wave manual activation (E.164, no +)
NEXT_PUBLIC_SUPPORT_WHATSAPP="221700000000"
NEXT_PUBLIC_SUPPORT_EMAIL="premium@afrilingua.ai"

