# Local dev (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# For Vercel: use a hosted Postgres (Neon, Vercel Postgres, Supabase) and
# change provider in prisma/schema.prisma to "postgresql":
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# 32+ char secret. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-with-openssl-rand-base64-48"
